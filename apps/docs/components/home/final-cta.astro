---
import Icon from "blume/components/Icon.astro";
---

<section
  class="mt-24 bg-accent pt-24 pb-20 [clip-path:polygon(0_40px,100%_0,100%_100%,0_100%)] md:mt-32 md:pt-32 md:pb-28"
>
  <div class="mx-auto max-w-6xl px-6 text-black">
    <p class="font-mono text-black/60 text-xs uppercase tracking-[0.3em]">
      {"//"} emailkit
    </p>
    <h2
      class="mt-4 font-display font-bold text-5xl uppercase italic leading-[0.9] tracking-tight sm:text-7xl"
    >
      Wire up email once.
    </h2>
    <p class="mt-5 max-w-lg text-pretty text-black/70 text-lg leading-relaxed">
      One client, one API — from your first welcome email to users connecting
      their own inboxes and domains. Configure email once, in one place, and
      it's done. Open source, TypeScript-first, nothing to host.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        class="lp-clip inline-flex h-12 items-center gap-2 bg-black px-7 font-bold text-accent text-sm uppercase tracking-wide transition-colors hover:bg-black/85"
        href="/quickstart"
      >
        Get started
        <Icon class="size-4" name="arrow-right" />
      </a>
      <a
        class="lp-clip inline-flex h-12 items-center border border-black/30 px-7 font-bold text-black text-sm uppercase tracking-wide transition-colors hover:bg-black/10"
        href="https://github.com/paukraft/emailkit"
        rel="noreferrer"
        target="_blank"
      >
        Star on GitHub
      </a>
    </div>
  </div>
</section>
